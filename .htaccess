# Anti-cache per lo sviluppo (opzionale).
#
# Serve HTML/CSS/JS senza cache, così durante lo sviluppo le modifiche si vedono
# subito senza dover svuotare la cache del browser. Richiede mod_headers; se non
# disponibile o se il file non viene copiato, il gioco funziona comunque (con la
# normale cache del browser). Nessuna dipendenza per il caricamento dei moduli:
# gli import sono relativi, quindi il gioco gira in qualsiasi cartella.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>
